{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram Advisor",
  "version": "0.1.0",
  "identifier": "com.lomovms.telegramadvisor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Telegram Advisor",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18791; img-src 'self' http://127.0.0.1:18791 data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/backend/telegram-advisor-backend.exe",
      "resources/codex/vendor"
    ]
  }
}
